{
  "expo": {
    "name": "LinkUp",
    "slug": "common",
    "scheme": "common",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.commonchat.app"
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.commonchat.app",
      "versionCode": 10,
      "icon": "./assets/android-icon.png"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo or sticker for LinkUp.",
          "cameraPermission": "Scan friend invitations or take a profile photo in LinkUp.",
          "microphonePermission": "Use your microphone when you accept or start a LinkUp call."
        }
      ],
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Use Face ID to unlock your LinkUp messages on this device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan friend invitations or take a profile photo in LinkUp.",
          "microphonePermission": "Use your microphone when you accept or start a LinkUp call.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      "react-native-quick-crypto",
      "expo-font",
      "./plugins/withNearby.cjs",
      "./plugins/withCallDependencies.cjs",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Use your camera when you accept or start a LinkUp video call.",
          "microphonePermission": "Use your microphone when you accept or start a LinkUp call."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FAFAF6",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#171D19"
          }
        }
      ],
      "./plugins/withScreenPrivacy.cjs",
      "./plugins/withPatchedCrypto.cjs"
    ]
  }
}
